# Usar Ubuntu 24.04 LTS como base
FROM ubuntu:24.04

LABEL maintainer="tu_correo@example.com"

ENV DEBIAN_FRONTEND=noninteractive
ENV PORT=8080

# Actualizar el sistema e instalar dependencias necesarias
RUN apt-get update && \
    apt-get install -y \
        apache2 \
        php \
        php-cgi \
        libapache2-mod-php \
        wget \
        unzip \
        git \
        build-essential \
        cmake \
        gdal-bin \
        python3 \
        python3-pip \
        python3-dev \
        python3-venv \
        supervisor \
        curl && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*

# Descargar y compilar ZooProject
RUN mkdir /zoo && \
    cd /zoo && \
    git clone https://github.com/ZOO-Project/ZOO-Project.git . && \
    mkdir build && \
    cd build && \
    cmake .. && \
    make && \
    make install

# Configurar ZooProject en Apache
RUN ln -s /usr/lib/cgi-bin/zoo_loader.cgi /var/www/html/zoo_loader.cgi && \
    echo 'export LD_LIBRARY_PATH=/usr/local/lib' >> /etc/apache2/envvars && \
    a2enmod cgi && \
    service apache2 restart

# Copiar archivo de configuración personalizado
COPY zoo.cfg /usr/local/etc/zoo-project/zoo.cfg

# Crear directorio para los servicios y ajustar permisos
RUN mkdir -p /usr/local/share/zoo-services && \
    chown www-data:www-data /usr/local/share/zoo-services

# Exponer el puerto definido por la variable de entorno
EXPOSE 8080

# Iniciar Apache en primer plano y escuchar en el puerto definido por la variable `PORT`
CMD ["sh", "-c", "apachectl -D FOREGROUND -k start -e info -E /dev/stderr -DFOREGROUND"]
