# Usar Ubuntu 24.04 LTS como imagen base
FROM ubuntu:24.04

# Información del mantenedor
LABEL maintainer="tu_correo@example.com"

# Configuración de entorno para evitar interacciones durante la instalación
ENV DEBIAN_FRONTEND=noninteractive

# Actualizar el sistema e instalar dependencias necesarias
RUN apt-get update && \
    apt-get install -y \
        apache2 \
        php \
        php-cgi \
        libapache2-mod-php \
        wget \
        unzip \
        git \
        build-essential \
        cmake \
        gdal-bin \
        python3 \
        python3-pip \
        python3-dev \
        python3-venv \
        supervisor \
        curl && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*

# Descargar y compilar ZooProject
RUN mkdir /zoo && \
    cd /zoo && \
    git clone https://github.com/ZooProject/ZooProject.git . && \
    mkdir build && \
    cd build && \
    cmake .. && \
    make && \
    make install

# Configurar ZooProject en Apache
RUN ln -s /usr/lib/cgi-bin/zoo_loader.cgi /var/www/html/zoo_loader.cgi && \
    echo 'export LD_LIBRARY_PATH=/usr/local/lib' >> /etc/apache2/envvars && \
    a2enmod cgi && \
    service apache2 restart

# Copiar archivo de configuración personalizado (asegúrate de tener este archivo en el mismo directorio que el Dockerfile)
COPY zoo.cfg /usr/local/etc/zoo-project/zoo.cfg

# Crear directorio para los servicios de ZooProject y ajustar permisos
RUN mkdir -p /usr/local/share/zoo-services && \
    chown www-data:www-data /usr/local/share/zoo-services

# Exponer el puerto 80 para acceder al servicio
EXPOSE 80

# Comando para iniciar Apache en primer plano
CMD ["apachectl", "-D", "FOREGROUND"]
